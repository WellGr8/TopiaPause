{
  "$schema": "workers/api/node_modules/wrangler/config-schema.json",
  "name": "topiapause",
  "main": "workers/api/src/index.ts",
  "compatibility_date": "2026-10-15",
  "compatibility_flags": ["nodejs_compat"],
  // Cloudflare Workers Builds runs `pnpm install && pnpm build` then `wrangler deploy`
  // from the repo root. Paths here are relative to this file.
  // Keep workers/api/wrangler.jsonc in step: `pnpm dev:worker` uses that copy.
  "assets": {
    "directory": "apps/web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "ratelimits": [
    { "name": "RATE_LIMITER", "namespace_id": "4101", "simple": { "limit": 120, "period": 60 } },
    { "name": "RATE_LIMITER_PAID", "namespace_id": "4102", "simple": { "limit": 20, "period": 60 } },
    { "name": "RATE_LIMITER_STT", "namespace_id": "4103", "simple": { "limit": 10, "period": 60 } }
  ],
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.1 }
  },
  "vars": {
    "LLM_BASE_URL": "https://openrouter.ai/api/v1",
    "LLM_MODEL": "openai/gpt-4o-mini",
    "ELEVENLABS_VOICE_ID": "nPczCjzI2devNBz1zQrb",
    "ELEVENLABS_MODEL_ID": "eleven_v4",
    "ALLOWED_ORIGIN": ""
  }
}
