# Copy to .dev.vars (git-ignored) for `pnpm dev:worker`. Never commit real values.
# Everything except the signing key is optional: without LLM/TTS keys /api/agent/chat
# uses the scripted mock and /api/voice/tts answers 503 so the web app falls back to browser speech.
#
# DEV=1 is local only. It allows a missing Origin and an ephemeral signing key.
# Do not set DEV in production wrangler vars or the fail-closed checks turn off.
DEV=1

# Secrets only. Do not put these in wrangler.jsonc `vars` — a deploy replaces the live
# Worker's vars, and keys must stay in `wrangler secret put` / this file.
# Non-secret defaults already live in wrangler.jsonc:
#   LLM_BASE_URL=https://openrouter.ai/api/v1
#   LLM_MODEL=openai/gpt-4o-mini
#   ELEVENLABS_VOICE_ID=nPczCjzI2devNBz1zQrb
#   ELEVENLABS_MODEL_ID=eleven_v4
# Uncomment a line below only to override that var for `wrangler dev`.

LLM_API_KEY=
# LLM_MODEL=openai/gpt-4o-mini
# LLM_BASE_URL=https://openrouter.ai/api/v1

# ElevenLabs. The same key serves text-to-speech and Scribe speech-to-text.
ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=nPczCjzI2devNBz1zQrb
# ELEVENLABS_MODEL_ID=eleven_v4

# Signs policy tokens, browser sessions, and verdict tickets (HMAC-SHA256).
# Required in production (`wrangler secret put`). With DEV=1 and an empty key, each
# isolate uses an ephemeral key and tokens stop verifying after a restart.
# Generate: openssl rand -base64 32
POLICY_SIGNING_KEY=

# Tokenomist Standard API (upcoming unlocks for the crypto risk note). Optional:
# without it the bundled sample (labelled "sample data, not live") is used.
TOKENOMIST_API_KEY=
