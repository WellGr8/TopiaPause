# Copy to .dev.vars (git-ignored) for `pnpm dev:worker`. Never commit real values.
# Everything is optional: without keys /api/agent/chat uses the scripted mock and
# /api/voice/tts answers 503 so the web app falls back to browser speech.

# Any OpenAI-compatible chat completions provider (OpenAI, OpenRouter, Groq, ...).
LLM_API_KEY=
# Overrides the non-secret vars in wrangler.jsonc for local runs:
# LLM_MODEL=gpt-4o-mini
# LLM_BASE_URL=https://api.openai.com/v1

# ElevenLabs text-to-speech.
ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=
# ELEVENLABS_MODEL_ID=eleven_v3

# Signs user policy tokens and verdict tickets (HMAC-SHA256). Required in production;
# without it each isolate makes a random key and tokens stop verifying after a restart.
# Generate: openssl rand -base64 32
POLICY_SIGNING_KEY=

# Tokenomist Standard API (upcoming unlocks for the crypto risk note). Optional:
# without it the bundled sample (labelled "sample data, not live") is used.
TOKENOMIST_API_KEY=
