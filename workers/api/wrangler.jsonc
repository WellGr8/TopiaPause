{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "topiapause",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-15",
  "compatibility_flags": ["nodejs_compat"],
  // One Worker serves the SPA build and /api/* on a single URL (ARCHITECTURE §9, Option A).
  // Run `pnpm build` first so ../../apps/web/dist exists.
  // The repo-root wrangler.jsonc is the same Worker for `wrangler deploy` from main.
  // Keep the two files in step.
  "assets": {
    "directory": "../../apps/web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // Per-IP limits. "api" covers guard/check and execute; "paid" covers routes that call LLM/ElevenLabs.
  "ratelimits": [
    { "name": "RATE_LIMITER", "namespace_id": "4101", "simple": { "limit": 120, "period": 60 } },
    { "name": "RATE_LIMITER_PAID", "namespace_id": "4102", "simple": { "limit": 20, "period": 60 } },
    { "name": "RATE_LIMITER_STT", "namespace_id": "4103", "simple": { "limit": 10, "period": 60 } }
  ],
  "durable_objects": {
    "bindings": [{ "name": "VERDICT_LEDGER", "class_name": "VerdictLedger" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["VerdictLedger"] }],
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.1 }
  },
  // Non-secret config only. Secrets (POLICY_SIGNING_KEY, LLM_API_KEY, ELEVENLABS_API_KEY, TOKENOMIST_API_KEY) go in .dev.vars
  // locally and `wrangler secret put <NAME>` (or the deploy workflow) in production.
  "vars": {
    "LLM_BASE_URL": "https://openrouter.ai/api/v1",
    "LLM_MODEL": "openai/gpt-4o-mini",
    "ELEVENLABS_VOICE_ID": "nPczCjzI2devNBz1zQrb",
    "ELEVENLABS_MODEL_ID": "eleven_v4",
    "ALLOWED_ORIGIN": ""
  }
}
