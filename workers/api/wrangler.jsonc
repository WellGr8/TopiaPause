{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "topiapause",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-15",
  "compatibility_flags": ["nodejs_compat"],
  // One Worker serves the SPA build and /api/* on a single URL (ARCHITECTURE §9, Option A).
  // Run `pnpm build` first so ../../apps/web/dist exists.
  "assets": {
    "directory": "../../apps/web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // Per-IP limits. "api" covers guard/check and execute; "paid" covers routes that call LLM/ElevenLabs.
  "ratelimits": [
    { "name": "RATE_LIMITER", "namespace_id": "4101", "simple": { "limit": 120, "period": 60 } },
    { "name": "RATE_LIMITER_PAID", "namespace_id": "4102", "simple": { "limit": 20, "period": 60 } }
  ],
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.1 }
  },
  // Non-secret config only. Secrets (LLM_API_KEY, ELEVENLABS_API_KEY) go in .dev.vars
  // locally and `wrangler secret put <NAME>` (or the deploy workflow) in production.
  "vars": {
    "LLM_BASE_URL": "https://api.openai.com/v1",
    "LLM_MODEL": "",
    "ELEVENLABS_VOICE_ID": "",
    "ELEVENLABS_MODEL_ID": "eleven_v3",
    "ALLOWED_ORIGIN": ""
  }
}
